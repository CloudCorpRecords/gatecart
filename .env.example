# GateCart payment configuration — copy to .env / export in your shell.
# NEVER commit real credentials. Sandbox credentials only for this project.

# auto (default): sandbox if credentials are present, simulator otherwise.
# simulator: local labeled simulation, no network. sandbox: real PayPal sandbox.
PAYPAL_MODE=auto

# Free sandbox credentials from https://developer.paypal.com
# (log in -> Apps & Credentials -> Sandbox -> create app -> Client ID / Secret)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Defaults to the sandbox host. Only change if PayPal instructs otherwise.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

PORT=3737
